# Токен бота от @BotFather
BOT_TOKEN=

# Ключ OpenAI-совместимого API
OPENAI_API_KEY=
# Адрес API: у OpenAI это https://api.openai.com/v1, у прокси-сервисов — свой
OPENAI_BASE_URL=https://api.openai.com/v1
# Модель для генерации планов и текстов
OPENAI_MODEL=gpt-5-mini
# Температура; оставьте пустой, если модель принимает только значение по умолчанию (семейство gpt-5)
OPENAI_TEMPERATURE=0.75
# Таймаут одного запроса к модели, секунды
OPENAI_TIMEOUT=60
# Сколько раз SDK повторяет запрос при сетевой ошибке, 429 или 5xx
OPENAI_MAX_RETRIES=2

# Пользователь PostgreSQL
DB_USER=marketaski
# Пароль PostgreSQL
DB_PASS=
# Имя базы данных
DB_NAME=marketaski
# Хост PostgreSQL
DB_HOST=localhost
# Порт PostgreSQL
DB_PORT=5432

# Хост Redis (хранит состояния диалогов)
REDIS_HOST=localhost
# Порт Redis
REDIS_PORT=6379
# Номер базы Redis
REDIS_DB=0
# Пароль Redis; пусто, если не задан
REDIS_PASSWORD=

# Часовой пояс, в котором пользователи вводят время публикаций
TIMEZONE=Europe/Moscow
# Как часто планировщик проверяет отложенные посты, секунды
SCHEDULER_POLL_INTERVAL=30
# Допустимое опоздание публикации, секунды: если бот был выключен дольше, пост помечается как пропущенный
SCHEDULER_MISFIRE_GRACE=3600
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
